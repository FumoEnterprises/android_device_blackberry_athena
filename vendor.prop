# Audio
debug.ftm.mixerpath=/vendor/etc/mixer_paths_bbe100.xml

# Bluetooth
bluetooth.device.default_name=BlackBerry Key2

# Camera
camera.ans.yproc.int.main=20,20,20,20
camera.ans.uvproc.int.main=20,20,20,20
camera.ans.scene.contract.main=0,0,0,0
persist.capture.burst.exposures=0,-9,9
persist.camera.ffcolor=FFBB77
persist.camera.ffcolor.th=3500
persist.camera.ffcolor.th2=4500
persist.camera.ffcolor.lev2=FFE4CA
persist.camera.ffcolor.lev3=ffdcb9
persist.camera.hal.debug=0
persist.camera.hal.debug.mask=0
persist.camera.isp.debug=0
persist.camera.isp.debug.mask=0
persist.camera.global.debug=0
persist.vendor.camera.isp.turbo=1
#persist.vendor.camera.stats.disablehaf=1
persist.vendor.camera.af.fovc.enable=0
video.disable.ubwc=1
persist.camera.preview.ubwc=0
vendor.camera.hal1.packagelist=com.dw.btime
persist.camera.expose.aux=1
persist.camera.dual_led_current=200,200,750,750
persist.camera.dual.camera=0

# Fingerprint - Goodix
ro.hardware.fingerprint=goodix
persist.vendor.fingerprint.type=home

# Radio
persist.radio.qcom_ext_enable=true
persist.vendor.radio.uicc_se_enabled=false
